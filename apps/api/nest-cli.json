{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "db/migrations/**/*.sql",
        "outDir": "dist"
      },
      {
        "include": "runtime/scenarios/*.json",
        "outDir": "dist"
      }
    ]
  },
  "entryFile": "src/main"
}
