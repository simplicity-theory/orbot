# ---- Product ----
# The product name shown in the header. Change it here, nowhere else.
ORBOT_PRODUCT_NAME=ORBOT

# ---- Database (docker compose) ----
ORBOT_DB_HOST=localhost
ORBOT_DB_PORT=5432
ORBOT_DB_NAME=orbot
# Superuser: used only by the compose init script.
POSTGRES_ADMIN_PASSWORD=change-me-admin
# Owner role: runs migrations (DDL). Never used by the running API.
ORBOT_DB_OWNER_PASSWORD=change-me-owner
# App role: SELECT + INSERT only on the record. Used by the running API.
ORBOT_DB_APP_PASSWORD=change-me-app

# ---- Secrets store (separate database, separate role) ----
ORBOT_SECRETS_DB_NAME=orbot_secrets
ORBOT_DB_SECRETS_PASSWORD=change-me-secrets
# 32-byte key, base64. `npm run dev` generates one into .env on first run.
ORBOT_SECRETS_KEY=

# ---- Commander auth ----
# Passphrase for the single Commander account. `npm run dev` generates one on first run.
ORBOT_COMMANDER_PASSPHRASE=
ORBOT_SESSION_SECRET=

# ---- API / web ----
ORBOT_API_PORT=3000
ORBOT_WEB_ORIGIN=http://localhost:4200

# ---- Bot runtime ----
# simulated | claude
ORBOT_RUNTIME=simulated
# Simulated time multiplier: 1 = demo pace, 0 = instant (tests).
ORBOT_SIM_SPEED=1
# Where per-task git worktrees are created.
ORBOT_WORKSPACES_DIR=./workspaces
# Used by ClaudeRuntime (Phase 4).
ORBOT_CLAUDE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
