# ---- Product ----
# The product name shown in the header. Change it here, nowhere else.
ORBOT_PRODUCT_NAME=ORBOT

# ---- Database (docker compose) ----
ORBOT_DB_HOST=localhost
ORBOT_DB_PORT=5432
ORBOT_DB_NAME=orbot
# Superuser: used only by the compose init script.
POSTGRES_ADMIN_PASSWORD=change-me-admin
# Owner role: runs migrations (DDL). Never used by the running API.
ORBOT_DB_OWNER_PASSWORD=change-me-owner
# App role: SELECT + INSERT only on the record. Used by the running API.
ORBOT_DB_APP_PASSWORD=change-me-app

# ---- Secrets store (separate database, separate role) ----
ORBOT_SECRETS_DB_NAME=orbot_secrets
ORBOT_DB_SECRETS_PASSWORD=change-me-secrets
# 32-byte key, base64. `npm run dev` generates one into .env on first run.
ORBOT_SECRETS_KEY=

# ---- Commander auth ----
# Passphrase for the single Commander account. `npm run dev` generates one on first run.
ORBOT_COMMANDER_PASSPHRASE=
ORBOT_SESSION_SECRET=

# ---- API / web ----
ORBOT_API_PORT=3000
ORBOT_WEB_ORIGIN=http://localhost:4200
# Production (see docs/deploy.md): serve the built web app from the API (one origin), trust the
# reverse proxy's X-Forwarded-* headers, and mark the session cookie Secure (auto = when the
# origin is https). The container image sets the first two.
ORBOT_WEB_DIST=
ORBOT_TRUST_PROXY=off
ORBOT_COOKIE_SECURE=auto
# What `npm run dev` / the container seed into an empty record: demo | force | none.
ORBOT_SEED=demo

# ---- Bot runtime ----
# simulated | claude (Anthropic API key) | claude-code (your own Claude plan, via the `claude` login)
ORBOT_RUNTIME=simulated
# Simulated time multiplier: 1 = demo pace, 0 = instant (tests).
ORBOT_SIM_SPEED=1
# How often each Overseer runs its cold-start check, in minutes (0 = only on demand).
ORBOT_COLDSTART_INTERVAL_MINUTES=360
# How often stuck work (stalls, timeouts) is looked for, in seconds (0 = never).
ORBOT_ESCALATION_SWEEP_SECONDS=30
# How often HQ checks whether the daily brief is due, in seconds (0 = only on demand).
ORBOT_DAILY_BRIEF_CHECK_SECONDS=60
# How often pending build pipelines on connected services are checked, in seconds (0 = only on push).
ORBOT_CONNECTIONS_POLL_SECONDS=30
# How often ORBOT follows app installs on your servers (deploy/apps).
ORBOT_APPS_POLL_SECONDS=10
# Where per-task git worktrees are created.
ORBOT_WORKSPACES_DIR=./workspaces
# Model for both Claude runtimes.
ORBOT_CLAUDE_MODEL=claude-opus-5-5
# Enables the `claude` runtime (billed to the API).
ANTHROPIC_API_KEY=
# Enables the `claude-code` runtime: bots run with Claude Code signed in with YOUR Claude plan
# (run `claude` once on this machine and log in). For one Commander's own use only: Anthropic's
# terms don't allow a Pro/Max login to serve other people, so don't use it while other officers
# give orders. On automatically when ORBOT_RUNTIME=claude-code.
ORBOT_CLAUDE_CODE=off
# Optional: a `claude` binary to use instead of the one bundled with the Agent SDK.
ORBOT_CLAUDE_CODE_PATH=
