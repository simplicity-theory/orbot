# ORBOT production settings. Copy to the repository root as .env and fill every value.
# Generate secrets with: openssl rand -base64 32   (ORBOT_SECRETS_KEY must be exactly 32 bytes)
# Never commit this file. Back up ORBOT_SECRETS_KEY with the database: without it the secrets
# store cannot be read.

# ---- Product ----
ORBOT_PRODUCT_NAME=ORBOT

# ---- Where ORBOT is reached (its one origin; https in production) ----
# With the tls profile this is https://<ORBOT_DOMAIN>.
ORBOT_WEB_ORIGIN=https://orbot.example.com
ORBOT_DOMAIN=orbot.example.com
# Bind the API to loopback (default); your reverse proxy faces the internet.
ORBOT_BIND=127.0.0.1
ORBOT_API_PORT=3000

# ---- Database (openssl rand -base64 24 for each) ----
POSTGRES_ADMIN_PASSWORD=
ORBOT_DB_OWNER_PASSWORD=
ORBOT_DB_APP_PASSWORD=
ORBOT_DB_SECRETS_PASSWORD=
ORBOT_DB_NAME=orbot
ORBOT_SECRETS_DB_NAME=orbot_secrets

# ---- Keys (openssl rand -base64 32) ----
ORBOT_SECRETS_KEY=
ORBOT_SESSION_SECRET=
# openssl rand -base64 18
ORBOT_COMMANDER_PASSPHRASE=

# ---- Bot runtime ----
# claude (ANTHROPIC_API_KEY) | claude-code (your Claude plan: mount the login, see docs/deploy.md)
# The simulated runtime (scripted bots, for trying the command system) is not installed in
# production unless ORBOT_RUNTIME=simulated, or ORBOT_SIMULATED=on.
ORBOT_RUNTIME=claude
ANTHROPIC_API_KEY=
ORBOT_CLAUDE_MODEL=claude-opus-5-5
ORBOT_CLAUDE_CODE=off
# Where the `claude` login lives on this machine (mounted into the container).
ORBOT_CLAUDE_HOME=/home/you/.claude

# ---- First start ----
# force: the four units with their Overseers and bots, ready for your repositories.
# demo: the demo force with example repositories and an operation (development).
# none: an empty record.
ORBOT_SEED=force

# ---- Pace ----
ORBOT_LOG_LEVEL=info
ORBOT_COLDSTART_INTERVAL_MINUTES=360
ORBOT_ESCALATION_SWEEP_SECONDS=30
ORBOT_DAILY_BRIEF_CHECK_SECONDS=60
ORBOT_CONNECTIONS_POLL_SECONDS=30
ORBOT_APPS_POLL_SECONDS=10
